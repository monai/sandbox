#!/bin/sh
set -eu

if mountpoint -q /storage; then
  sudo /usr/local/sbin/start-dockerd || echo "sandbox-entrypoint: dockerd failed to start" >&2
fi

rex server start \
  --extra-listen "http://0.0.0.0:7297" \
  --allow-anonymous \
  || echo "sandbox-entrypoint: rex server failed to start" >&2

exec "$@"
